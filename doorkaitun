-- ==================== CHỨC NĂNG GAME ====================
local function sendNotification(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 3
        })
    end)
end

local function interact(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt.MaxActivationDistance = 25
        fireproximityprompt(prompt)
        task.wait(Config.DelayAction)
    end
end

local function flyTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / Config.FlySpeed, 0.2, 3)
    
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

local function equipKey()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not backpack or not char then return end

    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Key" or string.find(tool.Name, "Key")) then
            tool.Parent = char
            task.wait(0.1)
            break
        end
    end
end

local function getCurrentRoom()
    local currentRooms = Workspace:FindFirstChild("CurrentRooms")
    if not currentRooms then return nil end
    local latestRoom, maxNum = nil, -1
    for _, room in pairs(currentRooms:GetChildren()) do
        local num = tonumber(room.Name)
        if num and num > maxNum then
            maxNum = num
            latestRoom = room
        end
    end
    return latestRoom
end

-- TRỐN RUSH / AMBUSH
local function hideFromEntity()
    if not Config.AutoHide then return end
    Config.IsHiding = true
    local room = getCurrentRoom()
    if not room then return end
    
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name == "Wardrobe" or string.find(obj.Name, "Closet") then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            local mainPart = obj:FindFirstChildWhichIsA("BasePart")
            if prompt and mainPart then
                flyTo(mainPart.CFrame * CFrame.new(0, 0, -2))
                interact(prompt)
                break
            end
        end
    end
end

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "RushMoving" then
        sendNotification("⚠️ CẢNH BÁO", "Rush xuất hiện!", 3)
        hideFromEntity()
        repeat task.wait(0.5) until not Workspace:FindFirstChild("RushMoving")
        task.wait(1)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.Jump = true
        end
        Config.IsHiding = false
    elseif child.Name == "AmbushMoving" then
        sendNotification("🚨 CẢNH BÁO", "Ambush xuất hiện!", 3)
        hideFromEntity()
        repeat task.wait(0.5) until not Workspace:FindFirstChild("AmbushMoving")
        task.wait(1.5)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.Jump = true
        end
        Config.IsHiding = false
    end
end)

-- VÒNG LẶP AUTO FARM CHÍNH
local lastProcessedRoom = nil

task.spawn(function()
    while true do
        task.wait(0.3)
        
        if Config.AutoFarm and not Config.IsHiding then
            local room = getCurrentRoom()
            
            if room and room ~= lastProcessedRoom then
                task.wait(0.3) -- Đợi load dữ liệu phòng
                
                -- BƯỚC 1: LỤC SẠCH TỦ LẤY GOLD
                local drawers = {}
                for _, obj in pairs(room:GetDescendants()) do
                    if string.find(obj.Name, "Drawer") or obj.Name == "Gold" or obj.Name == "CoinStack" then
                        table.insert(drawers, obj)
                    end
                end

                for _, drawer in ipairs(drawers) do
                    if Config.IsHiding or not Config.AutoFarm then break end
                    local prompt = drawer:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then
                        pcall(interact, prompt)
                    end
                end

                -- BƯỚC 2: TÌM & NHẶT CHÌA KHÓA
                for _, obj in pairs(room:GetDescendants()) do
                    if Config.IsHiding or not Config.AutoFarm then break end
                    if obj.Name == "Key" or string.find(obj.Name, "Key") then
                        local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChild("ModulePrompt")
                        local keyPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if keyPart and prompt then
                            pcall(flyTo, keyPart.CFrame)
                            pcall(interact, prompt)
                        end
                    end
                end

                -- BƯỚC 3: CẦM CHÌA KHÓA VÀ ĐÂM CỬA MỞ PHÒNG
                if not Config.IsHiding and Config.AutoFarm then
                    equipKey()
                    
                    local door = room:FindFirstChild("Door")
                    if door then
                        local prompt = door:FindFirstChildOfClass("ProximityPrompt")
                        local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                        
                        if doorPart and prompt then
                            pcall(flyTo, doorPart.CFrame * CFrame.new(0, 0, -2))
                            pcall(interact, prompt)
                            lastProcessedRoom = room
                        end
                    end
                end
            end
        end
    end
end)
